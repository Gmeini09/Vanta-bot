# Copy to .env for local dev. On Railway, set these as service variables instead.

# --- Required ---
DISCORD_TOKEN=your-bot-token-here
CLIENT_ID=your-application-id-here

# --- Optional ---
# Register slash commands to one guild instantly (recommended during setup).
# Leave empty to register globally (can take up to 1 hour).
GUILD_ID=

# Channel where new members are welcomed. Empty disables welcomes.
WELCOME_CHANNEL_ID=

# Leave messages (falls back to WELCOME_CHANNEL_ID)
LEAVE_CHANNEL_ID=

# Role given automatically to new members
AUTOROLE_ID=

# Channel for moderation logs
MODLOG_CHANNEL_ID=

# Where warnings are stored (Railway: mount a Volume at /data)
DATA_DIR=./data

# Ticket system
TICKET_CATEGORY_ID=
TICKET_SUPPORT_ROLE_ID=
# Channel for ticket logs + transcripts (falls back to MODLOG_CHANNEL_ID)
TICKET_LOG_CHANNEL_ID=

# Tip: everything above can also be set inside Discord with /settings,
# and /setup-server configures all of it automatically.

# Self-role buttons as JSON: {"customId":"roleId", ...}
# Example: {"role_announcements":"123456789012345678","role_gamer":"987654321098765432"}
ROLE_BUTTONS=
